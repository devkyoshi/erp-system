{
  "info": {
    "_postman_id": "procurement-service-collection",
    "name": "Procurement Service",
    "description": "Collection for Procurement Service endpoints acting on Suppliers, Purchase Orders, and GRNs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Suppliers",
      "item": [
        {
          "name": "Create Supplier",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"company_name\": \"Tech Hardware Suppliers\",\n    \"contact_person\": \"John Doe\",\n    \"email\": \"john@techhardware.com\",\n    \"phone\": \"+1234567890\",\n    \"address\": {\n        \"street\": \"123 Tech Blvd\",\n        \"city\": \"Silicon Valley\",\n        \"country\": \"USA\"\n    }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/organizations/{{orgId}}/suppliers",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{orgId}}", "suppliers"]
            }
          },
          "response": []
        },
        {
          "name": "List Suppliers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organizations/{{orgId}}/suppliers?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{orgId}}", "suppliers"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "active",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Supplier",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/suppliers/{{supplierId}}",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers", "{{supplierId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Supplier",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"contact_person\": \"Jane Doe\",\n    \"phone\": \"+0987654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/suppliers/{{supplierId}}",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers", "{{supplierId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Supplier",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/suppliers/{{supplierId}}",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers", "{{supplierId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Purchase Orders",
      "item": [
        {
          "name": "Create Purchase Order",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"supplier_id\": \"{{supplierId}}\",\n    \"items\": [\n        {\n            \"product_id\": \"prod123\",\n            \"quantity\": 10,\n            \"unit_price\": 50.00\n        }\n    ],\n    \"expected_delivery_date\": \"2024-12-31T00:00:00Z\",\n    \"notes\": \"Urgent delivery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/organizations/{{orgId}}/purchase-orders",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{orgId}}", "purchase-orders"]
            }
          },
          "response": []
        },
        {
          "name": "List Purchase Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organizations/{{orgId}}/purchase-orders?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{orgId}}", "purchase-orders"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "draft",
                  "disabled": true
                },
                {
                  "key": "supplier_id",
                  "value": "{{supplierId}}",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Purchase Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/purchase-orders/{{poId}}",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-orders", "{{poId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update PO Status",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"ordered\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/purchase-orders/{{poId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-orders", "{{poId}}", "status"]
            }
          },
          "response": []
        },
        {
          "name": "Approve Purchase Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/purchase-orders/{{poId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-orders", "{{poId}}", "approve"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Purchase Order",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/purchase-orders/{{poId}}",
              "host": ["{{baseUrl}}"],
              "path": ["purchase-orders", "{{poId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Goods Received Notes (GRN)",
      "item": [
        {
          "name": "Create GRN",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"purchase_order_id\": \"{{poId}}\",\n    \"items\": [\n        {\n            \"po_item_id\": \"item123\",\n            \"quantity_received\": 10,\n            \"condition\": \"good\"\n        }\n    ],\n    \"delivery_note_number\": \"DN-2024-001\",\n    \"received_date\": \"2024-01-15T10:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/organizations/{{orgId}}/grns",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{orgId}}", "grns"]
            }
          },
          "response": []
        },
        {
          "name": "List GRNs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organizations/{{orgId}}/grns?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{orgId}}", "grns"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "received",
                  "disabled": true
                },
                {
                  "key": "purchase_order_id",
                  "value": "{{poId}}",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get GRN",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/grns/{{grnId}}",
              "host": ["{{baseUrl}}"],
              "path": ["grns", "{{grnId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Complete Inspection",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"qc_status\": \"passed\",\n    \"qc_notes\": \"All items in good condition.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/grns/{{grnId}}/inspect",
              "host": ["{{baseUrl}}"],
              "path": ["grns", "{{grnId}}", "inspect"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "orgId",
      "value": "your_org_id_here",
      "type": "string"
    },
    {
      "key": "supplierId",
      "value": "your_supplier_id_here",
      "type": "string"
    },
    {
      "key": "poId",
      "value": "your_po_id_here",
      "type": "string"
    },
    {
      "key": "grnId",
      "value": "your_grn_id_here",
      "type": "string"
    }
  ]
}
