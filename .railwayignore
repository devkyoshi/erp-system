# .railwayignore
# Files and directories to ignore during Railway deployment

# Development files
.env
.env.local
.env.development
.env.test
*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Documentation (optional - uncomment if you want to exclude)
# *.md
# docs/

# Test files (optional)
*_test.go
test/
tests/

# Docker files (not needed for Railway)
Dockerfile
docker-compose.yml
.dockerignore

# Git files
.git/
.gitignore
.gitattributes

# CI/CD files (optional)
.github/
.gitlab-ci.yml
.travis.yml

# Build artifacts
bin/
build/
dist/
*.exe
*.dll
*.so
*.dylib

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Node modules (if any)
node_modules/

# Coverage reports
coverage/
*.coverage
*.coverprofile

# Other services' code (uncomment the services you're NOT deploying)
# services/auth-service/
# services/org-service/
# services/product-service/
# services/inventory-service/
# services/license-service/
# services/subscription-service/
